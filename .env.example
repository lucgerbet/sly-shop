# Copy to .env.local for local development; set the same keys in Vercel's
# project environment variables for production. Never commit the filled file —
# .gitignore already covers .env*.
#
# Every variable below has a fallback in the code, so the site boots without
# any of them. What breaks is silent: checkout fails, the CRM never hears about
# the order, emails go nowhere. Fill them.

# ── Payment ──────────────────────────────────────────────────────────────
# Stripe secret key for the "l'atelier SLY" account (login gerbetluc2218@gmail.com).
# Use sk_test_… locally: the deposit checkout charges real money with sk_live_….
STRIPE_SECRET_KEY=

# ── Link to the CRM ──────────────────────────────────────────────────────
# Where the site stages an order the moment a deposit checkout is created, so
# the CRM holds the full configuration before the customer even pays.
SLY_CRM_URL=https://sly-crm.srv1758374.hstgr.cloud

# Shared secret for those server-to-server calls. Must match sly-crm's
# SLY_INTAKE_SECRET exactly. Never prefix it with NEXT_PUBLIC_ — that would
# ship it in the browser bundle for anyone to read.
SLY_INTAKE_SECRET=

# ── Email ────────────────────────────────────────────────────────────────
# Resend key, same account as the CRM. Only used by /api/submit-order, the
# internal "new order" notification.
RESEND_API_KEY=
# Must be on a domain verified in Resend. The resend.dev sandbox address only
# ever delivers to the account owner's own inbox.
RESEND_FROM_EMAIL=contact@sly-atelier.com
# Who gets that internal notification. Several addresses are not supported here
# (unlike the CRM) — this one takes a single address.
ORDER_NOTIFICATION_EMAIL=gerbetluc2218@gmail.com

# ── Public values (shipped to the browser) ───────────────────────────────
# NEXT_PUBLIC_ variables are readable by anyone visiting the site. Nothing
# secret ever goes here.
NEXT_PUBLIC_SITE_URL=https://www.sly-atelier.com
# The booking page embedded on the checkout success screen.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/gerbetluc2218/30min

# ── Optional ─────────────────────────────────────────────────────────────
# fal.ai key for image generation (src/lib/fal.ts). Leave empty unless you are
# working on that feature — the rest of the site does not need it.
FAL_KEY=
